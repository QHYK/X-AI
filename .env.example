# PostgreSQL connection string. Supabase can provide this from Project Settings > Database.
DATABASE_URL="postgresql://postgres:password@localhost:5432/x_ai_field"

# Set to true when the hosted PostgreSQL provider requires SSL.
# DATABASE_SSL="false"

# Static provider assignment for the normal Daily Workflow.
STAGE1_LLM_PROVIDER=openai
STAGE2_LLM_PROVIDER=deepseek
STAGE3_LLM_PROVIDER=openai
STAGE4_LLM_PROVIDER=openai

# Generic provider/model defaults for standalone diagnostics only.
LLM_PROVIDER=openai
# LLM_MODEL=

# Discovery D2 / D4 keep the configured LLM provider, Base URL and API key.
# Provider priority: DISCOVERY_D2_PROVIDER / DISCOVERY_D4_PROVIDER
# > DISCOVERY_LLM_PROVIDER > the existing LLM_PROVIDER.
# The selected provider resolves its own model, Base URL and API key.
# DISCOVERY_LLM_PROVIDER=
# DISCOVERY_D2_PROVIDER=
# DISCOVERY_D4_PROVIDER=
# Timeout priority: DISCOVERY_D2_TIMEOUT_MS / DISCOVERY_D4_TIMEOUT_MS
# > DISCOVERY_LLM_TIMEOUT_MS > the shared LLM client's SDK default.
# Leave all three unset to use the SDK default timeout.
# DISCOVERY_LLM_TIMEOUT_MS=
# DISCOVERY_D2_TIMEOUT_MS=
# DISCOVERY_D4_TIMEOUT_MS=

# D3 always uses the existing Codex Responses endpoint and Agents SDK.
# DISCOVERY_AGENT_MODEL falls back to CODEX_MODEL, then the code default.
# DISCOVERY_AGENT_MODEL=
# DISCOVERY_D3_TIMEOUT_MS=480000
# DISCOVERY_D3_MAX_TURNS=8
# DISCOVERY_D5_TIMEOUT_MS=480000
# DISCOVERY_D5_MAX_TURNS=8
# DISCOVERY_FETCH_CONTENT_TIMEOUT_MS=90000

OPENAI_API_KEY=api-key
OPENAI_BASE_URL=https://128api.cn/v1
OPENAI_MODEL=gpt-5.4-mini
# `npm run test:openai:chat` probes `/chat/completions`; Stage 4 Web Search uses `/responses`.

DEEPSEEK_API_KEY=api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

KIMI_API_KEY=api-key
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_MODEL=kimi-k3

STAGE1_BATCH_SIZE=5
